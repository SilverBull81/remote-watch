{
  "schema_version": 1,
  "endpoint": "https://lv.example.test:8443",
  "control_dir": "control",
  "log_dir": "logs",
  "notifications": {
    "config": "gateway_config.example.json",
    "host": "127.0.0.1",
    "port": 8765
  },
  "commands": {
    "config": "command_gateway.telegram.example.json",
    "host": "127.0.0.1",
    "port": 8766
  },
  "caddy": {
    "mode": "external"
  },
  "lifecycle": {
    "startup_timeout": 60,
    "shutdown_timeout": 30,
    "kill_timeout": 5,
    "heartbeat_interval": 1,
    "heartbeat_timeout": 15
  },
  "restart": {
    "max_restarts": 3,
    "window": 300,
    "initial_delay": 2,
    "max_delay": 30
  }
}
