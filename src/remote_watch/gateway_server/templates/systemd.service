[Unit]
Description=Remote Watch Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=3

[Service]
Type=exec
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=@@DIRECTORY@@
ExecStart=@@PYTHON@@ -I -B -m remote_watch.gateway_server --config @@CONFIG@@ --start --headless
Restart=on-failure
RestartSec=60
TimeoutStopSec=60
KillMode=control-group
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
