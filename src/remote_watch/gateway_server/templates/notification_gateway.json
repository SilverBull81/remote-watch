{
  "schema_version": 1,
  "destinations": [
    {
      "alias": "app1-telegram",
      "provider": "telegram",
      "settings": {
        "chat_id": 123456789,
        "token_env": "RW_TELEGRAM_BOT_TOKEN"
      }
    },
    {
      "alias": "app1-ntfy",
      "provider": "ntfy",
      "settings": {
        "topic": "replace-with-your-topic",
        "token_env": "RW_NTFY_TOKEN"
      }
    }
  ],
  "principals": [
    {
      "name": "app1",
      "identity": {
        "service": "app1",
        "environment": "production",
        "region": "region-1",
        "host": "app-host",
        "instance_id": "one"
      },
      "aliases": [
        "app1-telegram",
        "app1-ntfy"
      ],
      "token_env": "RW_NOTIFICATION_APP1_TOKEN"
    }
  ]
}
