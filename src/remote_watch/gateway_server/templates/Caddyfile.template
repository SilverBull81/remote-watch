{
    admin 127.0.0.1:2019
    auto_https disable_redirects
    skip_install_trust
    storage file_system @@STORAGE@@
    log {
        output file @@LOG@@ {
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }
    servers {
        max_header_size 16KB
        timeouts {
            read_header 5s
            read_body 15s
            idle 2m
        }
    }
}

@@ENDPOINT@@ {
    tls internal
    request_body {
        max_size 128KB
    }
@@ROUTES@@
    handle {
        respond 404
    }
}
