include AGENTS.md ARCHITECTURE.md PROJECT_BRIEF.md
include .gitattributes .gitignore
recursive-include docs *.md
include docs/examples/gateway_config.example.json
include docs/examples/gateway_config.inline.example.json
include docs/examples/gateway-nginx.conf
include docs/examples/command_gateway.telegram.example.json
include docs/examples/command_gateway.ntfy.example.json
include docs/examples/command_client.example.json
include docs/examples/gateway_server.example.json
include docs/examples/collect_caddy_state.ps1
