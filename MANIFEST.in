include AGENTS.md ARCHITECTURE.md PROJECT_BRIEF.md
include logo/remote_watch.png
include logo/remote_watch.ico
include .gitattributes .gitignore
recursive-include docs *.md
include docs/examples/notification_gateway.example.json
include docs/examples/notification_gateway.inline.example.json
include docs/examples/gateway-nginx.conf
include docs/examples/command_gateway.telegram.example.json
include docs/examples/command_gateway.ntfy.example.json
include docs/examples/command_client.example.json
include docs/examples/gateway_server.example.json
include docs/examples/collect_caddy_state.ps1
recursive-include tests *.py
recursive-include tools *.py
include .github/workflows/validation.yml
recursive-include src/remote_watch py.typed
recursive-include src/remote_watch/gateway_server/templates *.json *.md *.ps1 *.sh *.template
global-exclude credentials.local.json *.local.json
global-exclude gateway_settings.py
global-exclude gateway_config.json
global-exclude *.sqlite* *.db *.db-journal *.db-wal *.db-shm
global-exclude runtime.json *.gateway.lock
